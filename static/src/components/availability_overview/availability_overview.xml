<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="mrp_bom_availability_planner.BomAvailabilityOverview">
        <div class="o_bap_overview o_action">
            <div class="o_control_panel d-flex align-items-center justify-content-between border-bottom px-3 py-2">
                <div>
                    <ol class="breadcrumb mb-0">
                        <li class="breadcrumb-item active">
                            <t t-esc="title"/>
                        </li>
                    </ol>
                </div>
            </div>
            <div class="o_bap_overview_content p-3">
                <t t-if="state.isLoading">
                    <div class="text-muted" t-esc="loadingLabel"/>
                </t>
                <t t-else="">
                    <div class="o_bap_parameters border-bottom pb-3 mb-3">
                        <div class="row g-3 align-items-end">
                            <div class="col-12 col-xl-3">
                                <label class="form-label fw-semibold" t-esc="productFieldLabel"/>
                                <Many2XAutocomplete
                                    resModel="'product.product'"
                                    fieldString="productFieldLabel"
                                    activeActions="activeActions"
                                    getDomain.bind="getProductDomain"
                                    update.bind="updateProduct"
                                    value="productValue"
                                    placeholder="productFieldLabel"
                                />
                            </div>
                            <div class="col-12 col-xl-3">
                                <label class="form-label fw-semibold" t-esc="bomFieldLabel"/>
                                <Many2XAutocomplete
                                    resModel="'mrp.bom'"
                                    fieldString="bomFieldLabel"
                                    activeActions="activeActions"
                                    getDomain.bind="getBomDomain"
                                    update.bind="updateBom"
                                    value="bomValue"
                                    placeholder="bomFieldLabel"
                                />
                            </div>
                            <div class="col-12 col-xl-3">
                                <label class="form-label fw-semibold" t-esc="locationsFieldLabel"/>
                                <Many2XAutocomplete
                                    resModel="'stock.location'"
                                    fieldString="locationsFieldLabel"
                                    activeActions="locationActiveActions"
                                    getDomain.bind="getLocationDomain"
                                    update.bind="updateLocations"
                                    value="''"
                                    placeholder="locationsFieldLabel"
                                    isToMany="true"
                                />
                                <div class="o_bap_location_tags mt-2">
                                    <t t-foreach="state.locations" t-as="location" t-key="location.id">
                                        <span class="badge rounded-pill text-bg-secondary me-1 mb-1">
                                            <t t-esc="location.display_name"/>
                                            <button
                                                class="btn-close btn-close-white ms-1"
                                                type="button"
                                                t-on-click="() => this.removeLocation(location.id)"
                                            />
                                        </span>
                                    </t>
                                </div>
                            </div>
                            <div class="col-12 col-xl-3">
                                <label class="form-label fw-semibold" t-esc="availabilityBasisLabel"/>
                                <div class="btn-group w-100" role="group">
                                    <t t-foreach="state.setupData.availability_basis_options" t-as="option" t-key="option.value">
                                        <input
                                            class="btn-check"
                                            type="radio"
                                            name="bap_availability_basis"
                                            t-att-id="'bap_availability_basis_' + option.value"
                                            t-att-value="option.value"
                                            t-att-checked="state.availabilityBasis === option.value"
                                            t-on-change="onChangeAvailabilityBasis"
                                        />
                                        <label
                                            class="btn btn-outline-secondary"
                                            t-att-for="'bap_availability_basis_' + option.value"
                                            t-esc="option.label"
                                        />
                                    </t>
                                </div>
                            </div>
                        </div>
                        <div class="mt-3 d-flex gap-2">
                            <button
                                class="btn btn-primary"
                                type="button"
                                t-on-click="computeAvailability"
                                t-att-disabled="state.isComputing"
                                t-esc="computeLabel"
                            />
                            <button
                                class="btn btn-secondary"
                                type="button"
                                t-on-click="clearResult"
                                t-att-disabled="!state.result"
                                t-esc="clearLabel"
                            />
                        </div>
                    </div>

                    <div t-if="state.result" class="o_bap_summary">
                        <div class="row g-3">
                            <div class="col-12 col-md-4">
                                <div class="o_bap_metric">
                                    <div class="text-muted" t-esc="canProduceLabel"/>
                                    <div class="fs-4" t-esc="state.result.can_produce_qty"/>
                                </div>
                            </div>
                            <div class="col-12 col-md-4">
                                <div class="o_bap_metric">
                                    <div class="text-muted" t-esc="mainBottleneckLabel"/>
                                    <div class="fs-5" t-esc="state.result.bottleneck_product_display_name"/>
                                </div>
                            </div>
                            <div class="col-12 col-md-4">
                                <div class="o_bap_metric">
                                    <div class="text-muted" t-esc="bottleneckAvailabilityLabel"/>
                                    <div class="fs-4" t-esc="state.result.bottleneck_qty"/>
                                </div>
                            </div>
                        </div>
                        <BomAvailabilityOverviewTable
                            data="state.result.availability_overview_data"
                        />
                    </div>
                    <div t-else="" class="o_bap_empty border rounded bg-view p-4">
                        <div class="fw-semibold" t-esc="state.setupData.empty_message"/>
                    </div>
                </t>
            </div>
        </div>
    </t>
</templates>
