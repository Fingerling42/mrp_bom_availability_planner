<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_mrp_bom_availability_wizard_form" model="ir.ui.view">
        <field name="name">mrp.bom.availability.wizard.form</field>
        <field name="model">mrp.bom.availability.wizard</field>
        <field name="arch" type="xml">
            <form string="BoM Availability Planner" create="false" delete="false">
                <header>
                    <button name="action_compute_availability" string="Compute Availability" type="object" class="btn-primary"/>
                    <button name="action_clear_lines" string="Clear Lines" type="object"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name" invisible="1"/>
                            <field name="product_id" required="1"/>
                            <field name="product_tmpl_id" invisible="1"/>
                            <field name="bom_id" required="1" domain="[('type', 'in', ['normal', 'phantom']), '|', ('product_id', '=', product_id), '&amp;', ('product_id', '=', False), ('product_tmpl_id', '=', product_tmpl_id)]"/>
                            <field name="location_ids" widget="many2many_tags" required="1"/>
                            <field name="target_qty"/>
                        </group>
                        <group>
                            <field name="product_uom_id"/>
                            <field name="availability_basis" widget="radio"/>
                            <field name="explode_subassemblies"/>
                            <field name="include_zero_required"/>
                        </group>
                    </group>
                    <group string="Summary" col="4">
                        <field name="can_produce_qty"/>
                        <field name="bottleneck_product_id"/>
                        <field name="bottleneck_qty"/>
                        <field name="summary" nolabel="1" colspan="4" placeholder="Run Compute Availability to calculate component availability."/>
                    </group>
                    <notebook>
                        <page string="Components">
                            <field name="line_ids" readonly="1">
                                <tree decoration-danger="availability_state in ('shortage', 'zero')" decoration-success="availability_state == 'ok'" decoration-warning="bottleneck_note" decoration-bf="bottleneck_note" decoration-muted="line_type == 'subassembly'">
                                    <field name="bottleneck_note" optional="show"/>
                                    <field name="availability_state" optional="show"/>
                                    <field name="component_label" optional="show"/>
                                    <field name="required_qty_per_unit" optional="show"/>
                                    <field name="required_qty_for_target" optional="show"/>
                                    <field name="available_qty" optional="show"/>
                                    <field name="can_produce_qty" optional="show"/>
                                    <field name="shortage_qty" optional="show"/>
                                    <field name="product_uom_id" optional="show"/>
                                    <field name="line_type" optional="hide"/>
                                    <field name="level" optional="hide"/>
                                    <field name="product_id" optional="hide"/>
                                    <field name="parent_bom_id" optional="hide"/>
                                    <field name="available_location_note" optional="hide"/>
                                    <field name="route_note" optional="hide"/>
                                </tree>
                                <form string="Component Availability">
                                    <group>
                                        <group>
                                            <field name="bottleneck_note"/>
                                            <field name="availability_state"/>
                                            <field name="line_type"/>
                                            <field name="level"/>
                                            <field name="component_label"/>
                                            <field name="product_id"/>
                                            <field name="product_uom_id"/>
                                        </group>
                                        <group>
                                            <field name="required_qty_per_unit"/>
                                            <field name="required_qty_for_target"/>
                                            <field name="available_qty"/>
                                            <field name="can_produce_qty"/>
                                            <field name="shortage_qty"/>
                                        </group>
                                    </group>
                                    <group>
                                        <field name="parent_bom_id"/>
                                        <field name="available_location_note"/>
                                        <field name="route_note" nolabel="1"/>
                                    </group>
                                </form>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_mrp_bom_availability_wizard_server" model="ir.actions.server">
        <field name="name">BoM Availability Planner</field>
        <field name="model_id" ref="model_mrp_bom_availability_wizard"/>
        <field name="state">code</field>
        <field name="code">action = env["mrp.bom.availability.wizard"].action_open_planner()</field>
    </record>

    <menuitem
        id="menu_mrp_bom_availability_wizard"
        name="BoM Availability Planner"
        parent="mrp.menu_mrp_reporting"
        action="action_mrp_bom_availability_wizard_server"
        sequence="90"/>
</odoo>
